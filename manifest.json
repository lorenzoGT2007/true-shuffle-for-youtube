{
  "manifest_version": 3,
  "name": "True Shuffle for YouTube",
  "short_name": "True Shuffle",
  "version": "1.0.0",
  "description": "Shuffles a whole YouTube playlist like a deck of cards: every video plays once, in a truly random order, before anything repeats.",
  "homepage_url": "https://github.com/lorenzoGT2007/true-shuffle-for-youtube",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "True Shuffle",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "commands": {
    "toggle-unwatched": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Hide or show watched videos"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/yt-api.js", "src/page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/selectors.js", "src/shuffle.js", "src/ui.js", "src/watcher.js", "src/unwatched.js", "src/playlist-tools.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "true-shuffle-for-youtube@lorenzogt2007",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
